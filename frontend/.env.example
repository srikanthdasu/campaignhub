NEXT_PUBLIC_API_URL=http://localhost:3001

# "Sign in with Google" — same Client ID as the backend's GOOGLE_CLIENT_ID (a public identifier
# by design, safe in the browser). Leave unset and the Google button just doesn't render.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Error tracking (Sentry) — optional, degrades gracefully. A DSN is a public-safe identifier
# (only lets events be sent, not read), same as GOOGLE_CLIENT_ID above — fine to expose in the
# browser bundle. Get this from your Sentry frontend project's Settings > Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
