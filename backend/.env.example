DATABASE_URL="postgresql://campaignhub:campaignhub@localhost:5432/campaignhub?schema=public"
REDIS_URL="redis://localhost:6379"

PORT=3001
NODE_ENV=development

JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:3000"

# Azure AI Foundry — used by AI Captions (and future AI modules) for real model calls.
# Endpoint is the project's OpenAI-compatible chat completions URL; find both on the
# deployment's "Details" page in the Foundry portal.
AZURE_AI_FOUNDRY_ENDPOINT="https://<your-foundry-resource>.services.ai.azure.com/openai/v1/chat/completions"
AZURE_AI_FOUNDRY_KEY="change-me"
AZURE_AI_FOUNDRY_TEXT_MODEL="Llama-3.3-70B-Instruct"
