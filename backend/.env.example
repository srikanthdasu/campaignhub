DATABASE_URL="postgresql://campaignhub:campaignhub@localhost:5432/campaignhub?schema=public"
REDIS_URL="redis://localhost:6379"

PORT=3001
NODE_ENV=development

JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_EXPIRES_IN="7d"

# Encrypts connected social accounts' OAuth tokens at rest (AES-256-GCM). All three secrets
# above and this one must be at least 20 characters — validate-env.ts rejects a shorter value
# (including this literal "change-me") at startup rather than silently accepting a weak one.
TOKEN_ENCRYPTION_KEY="change-me-to-something-at-least-20-characters-long"

CORS_ORIGIN="http://localhost:3000"

# Razorpay — billing checkout (RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET) plus the webhook that
# activates a subscription server-side even if the browser never calls back after payment.
# RAZORPAY_WEBHOOK_SECRET is a SEPARATE secret from RAZORPAY_KEY_SECRET — set when creating the
# webhook (Settings > Webhooks in the Razorpay dashboard) pointed at POST /billing/webhooks/razorpay,
# subscribed to the payment.captured event.
RAZORPAY_KEY_ID="change-me"
RAZORPAY_KEY_SECRET="change-me"
RAZORPAY_WEBHOOK_SECRET="change-me"

# Outbound email for in-app notifications (publish failures, approval requests, etc.) — any
# standard SMTP account works (Gmail app password, SendGrid/SES SMTP relay, a company mailbox).
# Leave unset in dev: EmailService then just logs what it would have sent instead of failing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="\"CampaignHub AI\" <no-reply@campaignhub.ai>"

# Azure AI Foundry — used by AI Captions, AI Assistant, AI Strategy, and AI Video Studio's
# script step for real text-model calls. Endpoint is the project's OpenAI-compatible chat
# completions URL; find both on the deployment's "Details" page in the Foundry portal.
AZURE_AI_FOUNDRY_ENDPOINT="https://<your-foundry-resource>.services.ai.azure.com/openai/v1/chat/completions"
AZURE_AI_FOUNDRY_KEY="change-me"
AZURE_AI_FOUNDRY_TEXT_MODEL="Llama-3.3-70B-Instruct"

# Same Foundry project, an image-generation deployment — used by AI Video Studio's render
# step for the preview image. Also found on that deployment's own "Details" page (note this
# is a different endpoint path than the text one above, even within the same project).
AZURE_AI_FOUNDRY_IMAGE_ENDPOINT="https://<your-foundry-resource>.services.ai.azure.com/mai/v1/images/generations"
AZURE_AI_FOUNDRY_IMAGE_KEY="change-me"
AZURE_AI_FOUNDRY_IMAGE_MODEL="MAI-Image-2.5-Flash"
